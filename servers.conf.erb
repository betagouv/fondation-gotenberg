# Ce fichier est inclus au niveau `http { }` par le nginx-buildpack Scalingo
# (voir config/nginx.conf.erb du buildpack). C'est le seul emplacement où on
# peut déclarer `limit_req_zone` et un upstream.

limit_req_zone $binary_remote_addr zone=gotenberg:10m rate=5r/s;

upstream gotenberg {
  server 127.0.0.1:9091;
  keepalive 16;
}

# Volontairement PAS exposé sur Internet : on n'écoute pas sur `$PORT` (qui est
# routé publiquement pour un process type `web`). On bind l'interface privée du
# Private Network si elle existe, sinon on retombe sur le loopback. Dans les
# deux cas, aucune requête venue d'Internet ne peut atteindre nginx.
# Voir platform/networking/private de la doc Scalingo.
server {
  listen <%= ENV.fetch('SCALINGO_PRIVATE_HOSTNAME', '127.0.0.1') %>:8080;
  server_name _;

  charset utf-8;

  # Timeouts adaptés aux conversions PDF longues.
  proxy_connect_timeout 30s;
  proxy_send_timeout    300s;
  proxy_read_timeout    300s;
  send_timeout          300s;

  location = /health {
    access_log off;
    return 200 "ok\n";
  }

  location / {
    limit_req zone=gotenberg burst=20 nodelay;

    proxy_pass http://gotenberg;
    proxy_http_version 1.1;
    proxy_set_header Connection        "";
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
