#!/usr/bin/env bash
set -euo pipefail

# Ce script est exécuté par le Go buildpack Scalingo après `go build`.
# Il télécharge le binaire pdfcpu et les données de césure de Chromium, puis
# allège les polices installées par APT. Pas de pdftk ici, il faudrait une JRE.
# Le buildpack déplace tout ce qui est écrit dans `bin/` du build dir vers
# `/app/bin/` à l'exécution.

PDFCPU_VERSION="0.12.0"

mkdir -p bin

echo "-----> Installing pdfcpu v${PDFCPU_VERSION}"
tmp=$(mktemp -d)
curl -sSfL "https://github.com/pdfcpu/pdfcpu/releases/download/v${PDFCPU_VERSION}/pdfcpu_${PDFCPU_VERSION}_Linux_x86_64.tar.xz" \
  | tar -xJf - -C "${tmp}"
mv "${tmp}"/pdfcpu_*/pdfcpu bin/pdfcpu
chmod +x bin/pdfcpu

# Fichiers d'hyphénation Chromium requis par Gotenberg (voir
# pkg/modules/chromium). Chromium cherche `<dir>/<chromium-version>/hyph-<lang>.hyb`,
# donc on conserve le sous-dossier versionné tel qu'il est dans l'image upstream.
# Version alignée sur la release Gotenberg utilisée (cf. go.mod).
GOTENBERG_REF="v8.34.0"
CHROMIUM_HYPHEN_VERSION="120.0.6050.0"
HYPHEN_DIR="chromium-hyphen-data/${CHROMIUM_HYPHEN_VERSION}"

echo "-----> Downloading Chromium hyphenation data (fr, en-us, en-gb) from gotenberg ${GOTENBERG_REF}"
mkdir -p "${HYPHEN_DIR}"
for lang in fr en-us en-gb; do
  curl -sSfL -o "${HYPHEN_DIR}/hyph-${lang}.hyb" \
    "https://raw.githubusercontent.com/gotenberg/gotenberg/${GOTENBERG_REF}/build/chromium-hyphen-data/${CHROMIUM_HYPHEN_VERSION}/hyph-${lang}.hyb"
done

# Le binaire compilé par le Go buildpack s'appelle par défaut du nom du module
# (`scalingo-gotenberg`). Rien à faire ici. On vérifie seulement sa présence.
if [ ! -f bin/scalingo-gotenberg ]; then
  echo "WARN: bin/scalingo-gotenberg introuvable après compilation Go"
fi

echo "-----> Trimming installed fonts"
mv -v .apt/usr/share/fonts/truetype/noto/NotoSans-*.ttf .apt/usr/share/fonts/truetype && \
  rm -v .apt/usr/share/fonts/truetype/noto/*.ttf && \
  mv -v .apt/usr/share/fonts/truetype/NotoSans-*.ttf .apt/usr/share/fonts/truetype/noto && \
  rm -v -rf .apt/usr/share/fonts/opentype/montserrat && \
  rm -v -rf .apt/usr/share/fonts/truetype/montserrat && \
  rm -v -f .apt/usr/share/fonts/woff/montserrat/MontserratAlternates-*.{woff,woff2} && \
  fc-cache -f
