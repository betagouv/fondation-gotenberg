#!/usr/bin/env bash
set -euo pipefail

# Lance gotenberg en arrière-plan, attend que /health réponde, puis reste au
# premier plan pour supervisord. Si /health ne répond pas dans le délai, on
# tue gotenberg et on sort en erreur. supervisord logue et redémarre.

HEALTH_URL="http://127.0.0.1:9091/health"
HEALTH_TIMEOUT="${GOTENBERG_HEALTH_TIMEOUT:-90}"

/app/bin/scalingo-gotenberg \
  --api-bind-ip=127.0.0.1 \
  --api-port=9091 \
  --chromium-auto-start=true \
  --chromium-max-concurrency=2 \
  --chromium-max-queue-size=10 \
  --chromium-start-timeout=60s \
  --pdfengines-convert-engines=pdfcpu \
  --pdfengines-encrypt-engines=qpdf,pdfcpu \
  --pdfengines-merge-engines=qpdf,pdfcpu \
  --pdfengines-rotate-engines=pdfcpu \
  --pdfengines-split-engines=pdfcpu,qpdf \
  --pdfengines-stamp-engines=pdfcpu \
  --pdfengines-watermark-engines=pdfcpu \
  --prometheus-disable-collect=true \
  &
pid=$!

trap 'kill -TERM "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true' TERM INT

deadline=$(( $(date +%s) + HEALTH_TIMEOUT ))
until curl --silent --fail --max-time 2 "$HEALTH_URL" > /dev/null; do
  if ! kill -0 "$pid" 2>/dev/null; then
    echo "gotenberg s'est arrêté avant de devenir healthy" >&2
    wait "$pid" 2>/dev/null || true
    exit 1
  fi
  if [ "$(date +%s)" -gt "$deadline" ]; then
    echo "gotenberg /health n'a pas répondu en ${HEALTH_TIMEOUT}s" >&2
    kill -TERM "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    exit 1
  fi
  sleep 1
done

echo "gotenberg est healthy sur ${HEALTH_URL}"

wait "$pid"
