#!/usr/bin/env bash
set -euo pipefail

: "${SCALINGO_PRIVATE_HOSTNAME:?is not set}"

# Gotenberg only binds to an IP address, while Scalingo only gives the private hostname
ip=$(getent ahostsv4 "${SCALINGO_PRIVATE_HOSTNAME}" | awk 'NR == 1 { print $1 }' || true)

# Falling back to the loopback would leave a healthy looking container that no app can reach
if [ -z "${ip}" ]; then
  echo "${SCALINGO_PRIVATE_HOSTNAME} does not resolve: Gotenberg would be unreachable from the private network" >&2
  exit 1
fi

exec /app/bin/scalingo-gotenberg \
  --api-bind-ip="${ip}" \
  --api-port=8080 \
  --chromium-auto-start=true \
  --chromium-max-concurrency=2 \
  --chromium-max-queue-size=10 \
  --chromium-start-timeout=60s \
  --pdfengines-convert-engines=pdfcpu \
  --pdfengines-encrypt-engines=qpdf,pdfcpu \
  --pdfengines-merge-engines=qpdf,pdfcpu \
  --pdfengines-rotate-engines=pdfcpu \
  --pdfengines-split-engines=pdfcpu,qpdf \
  --pdfengines-stamp-engines=pdfcpu \
  --pdfengines-watermark-engines=pdfcpu \
  --prometheus-disable-collect=true
